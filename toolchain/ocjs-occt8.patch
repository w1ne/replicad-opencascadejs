+def _dropDanglingAliases(files):
+  # OCCT 8's Deprecated/NCollectionAliases contains a few aliases that include
+  # headers which no longer exist (or live in Draw); one missing include is a
+  # fatal error that ends the whole parse, so skip those aliases.
+  import re
+  available = set(os.path.basename(f) for f in files)
+  for p in ocIncludePaths:
+    available.update(os.listdir(p))
+  keep = []
+  for f in files:
+    if "/Deprecated/" in f:
+      incs = re.findall(r'#include\s*<([^>]+)>', open(f, errors="replace").read())
+      if any(i not in available and not i.startswith(("std", "c")) and i.endswith(".hxx") for i in incs):
