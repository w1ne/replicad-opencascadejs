   Standard_EXPORT void DumpJson(Standard_OStream& theOStream, int theDepth = -1) const;
 
+  //! kernelCAD compatibility (removed in OCCT 8): hash code of the TShape and
+  //! Location (orientation ignored, like IsSame) in the range [1, theUpperBound].
+  //! Same value as std::hash<TopoDS_Shape> modulo theUpperBound, plus one.
+  int HashCode(const int theUpperBound) const;
+
 protected:
   //! Checks if the transformation contains scaling or negative values.
   //! Raises an exception if the transformation is invalid.
@@ -341,4 +346,14 @@ struct hash<TopoDS_Shape>
 };
 } // namespace std
 
+inline int TopoDS_Shape::HashCode(const int theUpperBound) const
+{
+  if (theUpperBound < 1)
+  {
+    return 0;
+  }
+  return static_cast<int>(std::hash<TopoDS_Shape>{}(*this) % static_cast<size_t>(theUpperBound))
+         + 1;
+}
