+++ b/src/Visualization/TKV3d/StdPrs/StdPrs_ToolTriangulatedShape.hxx
@@ -17,6 +17,9 @@
 #include <BRepLib_ToolTriangulatedShape.hxx>
 #include <gp_Dir.hxx>
 #include <NCollection_Array1.hxx>
+#include <Poly_Connect.hxx>
+#include <Poly_Triangulation.hxx>
+#include <TopoDS_Face.hxx>
 
 class TopoDS_Shape;
 class Prs3d_Drawer;
@@ -71,6 +74,31 @@ public:
   Standard_EXPORT static void ClearOnOwnDeflectionChange(const TopoDS_Shape&              theShape,
                                                          const occ::handle<Prs3d_Drawer>& theDrawer,
                                                          const bool theToResetCoeff);
+
+  //! kernelCAD compatibility (removed in OCCT 8): evaluates the nodal normals of
+  //! the face triangulation into theNormals (computing them first if the
+  //! triangulation has none), reversed for a reversed face. Same as OCCT 7.6.
+  static void Normal(const TopoDS_Face&      theFace,
+                     Poly_Connect&           thePolyConnect,
+                     NCollection_Array1<gp_Dir>& theNormals)
+  {
+    const occ::handle<Poly_Triangulation>& aPolyTri = thePolyConnect.Triangulation();
+    if (!aPolyTri->HasNormals())
+    {
+      ComputeNormals(theFace, aPolyTri, thePolyConnect);
+    }
+    for (int aNodeIter = 1; aNodeIter <= aPolyTri->NbNodes(); ++aNodeIter)
+    {
+      theNormals.ChangeValue(aNodeIter) = aPolyTri->Normal(aNodeIter);
+    }
+    if (theFace.Orientation() == TopAbs_REVERSED)
+    {
+      for (int aNodeIter = 1; aNodeIter <= aPolyTri->NbNodes(); ++aNodeIter)
+      {
+        theNormals.ChangeValue(aNodeIter).Reverse();
+      }
+    }
+  }
 };
 
 #endif
